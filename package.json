{
  "name": "anka-web",
  "version": "1.4.8",
  "description": "Anka Web",
  "main": "src/core/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "npx electron-builder --win",
    "build:linux-dir": "npx electron-builder --linux dir",
    "build:all": "npx electron-builder --win && npx electron-builder --linux dir && node scripts/pack-deb.js"
  },
  "author": "WraitGame <wraitstudio@gmail.com>",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "javascript-obfuscator": "^5.4.3"
  },
  "build": {
    "appId": "com.wraitgame.ankaweb",
    "productName": "Anka Web",
    "files": [
      "src/**/*",
      "icons/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "HTTP Protocol",
        "schemes": ["http"]
      },
      {
        "name": "HTTPS Protocol",
        "schemes": ["https"]
      }
    ],
    "fileAssociations": [
      {
        "ext": ["html", "htm", "shtml", "xhtml"],
        "name": "HTML Document",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "icons/logo.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": true,
      "installerIcon": "icons/logo.ico",
      "uninstallerIcon": "icons/logo.ico",
      "installerHeaderIcon": "icons/logo.ico",
      "uninstallDisplayName": "Anka Web",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Anka Web",
      "language": "1055",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "Anka_Web_${version}.${ext}"
    },
    "linux": {
      "icon": "icons/logo.png",
      "category": "Network;WebBrowser;",
      "mimeTypes": [
        "text/html",
        "application/xhtml+xml",
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "target": ["dir"]
    }
  }
}