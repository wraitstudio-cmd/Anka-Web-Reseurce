{
  "name": "anka-web",
  "version": "1.4.1",
  "description": "Anka Web Browser",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "obfuscate": "npx javascript-obfuscator ./src --output ./dist --compact true --self-defending true",
    "build:win": "npm run obfuscate && npx electron-builder --win",
    "build:linux-dir": "npm run obfuscate && npx electron-builder --linux dir",
    "build:all": "npm run obfuscate && npx electron-builder --win && npx electron-builder --linux dir && node pack-deb.js"
  },
  "author": "WraitGame <wraitstudio@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "javascript-obfuscator": "^5.4.3"
  },
"build": {
    "appId": "com.wraitgame.ankaweb",
    "productName": "Anka Web Browser",
    "win": {
      "icon": "assets/icons/logo.ico",
      "target": [
        "nsis"
      ]
    },
"nsis": {
  "oneClick": false,
  "allowToChangeInstallationDirectory": true,
  "warningsAsErrors": false,
  "installerIcon": "assets/icons/logo.ico",
  "uninstallerIcon": "assets/icons/logo.ico",
  "uninstallDisplayName": "Anka Web Browser Kaldır",
  "language": "1055",
  "createDesktopShortcut": "always",
  "createStartMenuShortcut": true,
  "shortcutName": "Anka Web Browser",
  "allowElevation": true,
  "perMachine": true
},
    "linux": {
      "icon": "assets/icons/256x256.png",
      "target": [
        "dir"
      ]
    }
  }
}